@model MovieBookingSystem.Models.BookingModel

@{
    ViewBag.Title = "Delete Booking";
}

<h2>Delete Booking</h2>

<div class="alert alert-warning">

    <h4>
        Are you sure you want to delete this booking?
    </h4>

</div>

<div>

    <dl class="dl-horizontal">

        <dt>
            Booking ID
        </dt>

        <dd>
            @Model.booking_ID
        </dd>

        <dt>
            Category ID
        </dt>

        <dd>
            @Model.Cat_ID
        </dd>

        <dt>
            Movie ID
        </dt>

        <dd>
            @Model.Movie_ID
        </dd>

        <dt>
            Number of Tickets
        </dt>

        <dd>
            @Model.no_of_Tickets
        </dd>

        <dt>
            Amount
        </dt>

        <dd>
            @Model.amount
        </dd>

    </dl>

</div>

@using (Html.BeginForm(
    "Delete",
    "Booking",
    FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(
        model => model.booking_ID)

    <button type="submit"
            class="btn btn-danger">
        Delete Booking
    </button>

    @Html.ActionLink(
        "Cancel",
        "Index",
        "Booking",
        null,
        new
        {
            @class = "btn btn-secondary"
        })
}